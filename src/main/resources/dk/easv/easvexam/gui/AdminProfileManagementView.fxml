<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvexam.gui.AdminProfileManagementController">
    <children>
        <SplitPane dividerPositions="0.45" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>
                <AnchorPane minWidth="350.0">
                    <children>
                        <VBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="Profiles List" />
                                <TableView VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn prefWidth="40.0" text="ID" />
                                        <TableColumn prefWidth="120.0" text="Profile Name" />
                                        <TableColumn prefWidth="150.0" text="Actions" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <HBox spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" prefHeight="30.0" prefWidth="100.0" text="+ Add New" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <AnchorPane minWidth="450.0" style="-fx-background-color: white;">
                    <children>
                        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16;" text="Profile Settings" />

                                <GridPane vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Profile Name:" />
                                        <TextField GridPane.columnIndex="1" />

                                        <Label text="Brightness:" GridPane.rowIndex="1" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <children>
                                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                                    <image>
                                                        <Image url="@images/3sun.png" />
                                                    </image>
                                                </ImageView>
                                                <Slider max="1.0" min="-1.0" HBox.hgrow="ALWAYS" />
                                                <Label prefWidth="40.0" text="0%" />
                                            </children>
                                        </HBox>

                                        <Label text="Rotation:" GridPane.rowIndex="2" />
                                        <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                            <children>
                                                <Label style="-fx-font-size: 16;" text="°" />
                                                <TextField prefWidth="60.0" promptText="0" />
                                                <Label text="degrees (-180 to 180)" textFill="#949494" style="-fx-font-size: 11;"/>
                                            </children>
                                        </HBox>

                                        <Label text="Options:" GridPane.rowIndex="3" />
                                        <CheckBox mnemonicParsing="false" text="Split by barcode" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                    </children>
                                </GridPane>

                                <Separator prefWidth="200.0" />

                                <VBox alignment="CENTER" spacing="10.0" VBox.vgrow="ALWAYS" style="-fx-background-color: #f9f9f9; -fx-border-color: #eee; -fx-border-radius: 5;">
                                    <children>
                                        <Label text="Preview" textFill="#868686" />
                                        <ImageView fitHeight="180.0" fitWidth="280.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                                        </ImageView>
                                    </children>
                                </VBox>

                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Save Profile" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </items>
        </SplitPane>
    </children>
</AnchorPane>

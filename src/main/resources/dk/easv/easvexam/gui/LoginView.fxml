<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" spacing="25.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvexam.gui.LoginController">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <ImageView fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@images/LogoGreen2H.png" />
        </image>
    </ImageView>

    <VBox maxWidth="260.0" spacing="12.0" alignment="CENTER">
        <children>
            <TextField fx:id="username" prefHeight="35.0" promptText="Enter Username" />
            <PasswordField fx:id="password" prefHeight="35.0" promptText="Enter Password" />
            <Button maxWidth="1.7976931348623157E308" prefHeight="35.0" onAction="#onLoginClick" text="Login" />
        </children>
    </VBox>

</VBox>
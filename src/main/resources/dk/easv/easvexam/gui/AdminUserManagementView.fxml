<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvexam.gui.AdminController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="Admin Dashboard">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#logOut" text="Log Out">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="User Management">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#openAddUser" prefHeight="33.0" prefWidth="120.0" text="Add User" />
                        <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#openLogging" prefHeight="31.0" prefWidth="88.0" text="Logs" />
                        <Button mnemonicParsing="false" onAction="#openProfileManagement" prefHeight="33.0" prefWidth="180.0" text="Profile management" />
                    </children>
                </HBox>

                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="usernameColumn" minWidth="50.0" prefWidth="80.0" text="Username" />

                        <TableColumn fx:id="roleColumn" maxWidth="120.0" minWidth="80.0" prefWidth="100.0" text="Role" />

                        <TableColumn fx:id="profilesColumn" minWidth="350.0" prefWidth="500.0" text="Profiles" />

                        <TableColumn fx:id="colActions" maxWidth="160.0" minWidth="150.0" prefWidth="155.0" resizable="false" text="Actions" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>

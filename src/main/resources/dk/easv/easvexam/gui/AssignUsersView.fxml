<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500.0" prefWidth="400.0" stylesheets="@css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvexam.gui.AssignUsersController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
            <HBox prefHeight="21.0" prefWidth="360.0">
               <children>
                      <Label fx:id="lblTitle" prefHeight="31.0" prefWidth="258.0" style="-fx-font-size: 16; -fx-font-weight: bold;" text="Assign Users to Profile" />
                  <Region prefHeight="0.0" prefWidth="149.0" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchUserField" prefHeight="31.0" prefWidth="183.0" promptText="Search users by username..." />
               </children>
            </HBox>

                <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSelected" prefWidth="50.0" text="Select" />
                        <TableColumn fx:id="colUsername" prefWidth="200.0" text="Username" />
                        <TableColumn fx:id="colRole" prefWidth="100.0" text="Role" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" prefHeight="69.0" prefWidth="360.0" spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#cancel" prefHeight="47.0" prefWidth="133.0" text="Cancel" />
                        <Button mnemonicParsing="false" onAction="#onSave" prefHeight="47.0" prefWidth="133.0" text="Save Changes" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>

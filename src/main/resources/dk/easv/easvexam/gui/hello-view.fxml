<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.layout.StackPane?>
<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvexam.gui.HelloController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10; -fx-background-color: #f4f4f4;">
            <Button onAction="#onScanButtonClick" text="Scan Document" />
            <Button onAction="#onRotateButtonClick" text="Rotate 90°" />
         <Button mnemonicParsing="false" onAction="#onZoomIn" text="Zoom in" />
         <Button mnemonicParsing="false" onAction="#onZoomOut" text="Zoom out" />
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.25">
            <TreeView fx:id="docTreeView" />

            <ScrollPane fx:id="scrollPane" pannable="true" fitToWidth="false" fitToHeight="false" style="-fx-background-color: #d3d3d3;">
                <content>
                    <StackPane fx:id="imageContainer">
                        <ImageView fx:id="imageView" preserveRatio="true" />
                    </StackPane>
                </content>
            </ScrollPane>
        </SplitPane>
    </center>
</BorderPane>

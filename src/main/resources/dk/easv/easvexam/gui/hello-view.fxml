<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="dk.easv.easvexam.gui.HelloController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <Button onAction="#onScanButtonClick" text="Scan Document" />
            <Button onAction="#onRotateButtonClick" text="Rotate 90°" />
         <Button mnemonicParsing="false" text="Button" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="false" fitToWidth="false" pannable="true">
            <ImageView fx:id="imageView" preserveRatio="true" />
        </ScrollPane>
    </center>
</BorderPane>
